### Bootstrap for the test suite.
###
###   cp .env.testing.example .env.testing
###   vendor/bin/pest
###
### Without a .env.testing (or a .env) the whole suite boots without an
### application key: ~92 tests fail with MissingAppKeyException and the rest
### come out as warnings. That looks like a green-ish run but proves nothing.
###
### These values mirror the <php><env> block of phpunit.xml so the suite behaves
### the same whether it runs via `vendor/bin/pest`, `php artisan test` or an IDE
### runner. There are NO real credentials here and there must never be any: the
### file is committed. Anything secret goes in .env.testing, which is ignored.

APP_NAME="Piedritas (testing)"
APP_ENV=testing
# Throwaway key, valid only for booting the encrypter against an in-memory
# SQLite database. Never reuse it anywhere else.
APP_KEY=base64:2r5nJb4V2gGA1TrLwOCcm+xTAA4Zw5xIQnbPeaonuiE=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=:memory:

CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false

PUSHER_APP_ID=testing
PUSHER_APP_KEY=testing
PUSHER_APP_SECRET=testing
PUSHER_APP_CLUSTER=mt1
